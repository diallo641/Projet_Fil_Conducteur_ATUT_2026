
#Identifiants sous MinIO 
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SSL=false


# Les trois Buckets(Extraction, Transformation et Chargement) Minio
EXTRACTION_BUCKET=s3a://extraction/
TRANSFORMATION_BUCKET=s3a://transformation/livres/
CHARGEMENT_BUCKET=s3a://chargement/livres/


# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=Books_ETL


# Identifiants PostgreSQL (Airflow)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# Airflow
AIRFLOW_EXECUTOR=LocalExecutor
AIRFLOW_LOAD_EXAMPLES=false
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_PORT=8080